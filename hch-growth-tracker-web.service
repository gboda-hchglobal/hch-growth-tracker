[Unit]
Description=HCH Growth Tracker web app
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/hch-growth-tracker-web
ExecStart=/root/.nvm/versions/node/v22.23.1/bin/npm start -- --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/root/.nvm/versions/node/v22.23.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
